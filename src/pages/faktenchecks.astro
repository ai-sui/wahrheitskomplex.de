---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaktencheckCard from '../components/FaktencheckCard.astro';
import { withBase } from '../utils/url';

const faktenchecks = (await getCollection('faktenchecks')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Distinct outlets for filter chips (sorted by frequency desc, then alpha)
const outletCounts = new Map<string, number>();
for (const fc of faktenchecks) {
  outletCounts.set(
    fc.data.faktenchecker,
    (outletCounts.get(fc.data.faktenchecker) ?? 0) + 1,
  );
}
const outlets = Array.from(outletCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name]) => name);

// ItemList-Schema fuer die Vollliste (hilft Google, die Seite als
// strukturierte Sammlung zu verstehen)
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Faktenchecker im Check',
  description:
    'Dokumentierte Faelle, in denen etablierte Faktencheck-Stellen falsch oder irrefuehrend gestempelt haben.',
  numberOfItems: faktenchecks.length,
  itemListElement: faktenchecks.map((fc, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: fc.data.title,
    url: fc.data.url,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Start',
      item: new URL(withBase('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Faktenchecks',
      item: new URL(withBase('/faktenchecks'), Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title="Faktenchecker im Check — 18 dokumentierte Fehlgriffe"
  description="18 Fälle, in denen Faktenchecker deutscher und internationaler Medien danebenlagen — recherchiert und dokumentiert von Norbert Häring. Mit Verdict, Aktenlage und Quellen."
  jsonLd={[itemListSchema, breadcrumbSchema]}
>
  <section class="container-page py-12 md:py-16">
    <p class="meta-label text-accent mb-3">Faktenchecks</p>
    <h1 class="font-serif text-3xl md:text-4xl leading-tight mb-4 max-w-3xl">
      Wenn Faktenchecker selbst Faktenchecks brauchen.
    </h1>
    <p class="max-w-2xl text-ink-soft text-lg leading-relaxed">
      Eine kuratierte Sammlung von Fällen, in denen Faktencheck-Stellen
      Behauptungen als „falsch" oder „irreführend" stempelten — und
      Norbert Häring anhand der Quellen das Gegenteil oder eine deutlich
      differenziertere Lage belegt. Jeder Eintrag verlinkt auf den
      vollständigen Tiefenartikel.
    </p>

    <div class="mt-10 border-y border-line py-6">
      <fieldset class="flex flex-col gap-2.5" data-filter-group="faktenchecker">
        <legend class="meta-label">Faktenchecker</legend>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class="filter-chip is-active"
            data-filter-value="__all__"
            aria-pressed="true"
          >
            Alle
          </button>
          {outlets.map((o) => (
            <button
              type="button"
              class="filter-chip"
              data-filter-value={o}
              aria-pressed="false"
            >
              {o} <span class="opacity-60">({outletCounts.get(o)})</span>
            </button>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="mt-4 flex items-center justify-between text-sm text-muted">
      <p data-count>{faktenchecks.length} Faktenchecks</p>
      <button
        type="button"
        class="underline decoration-line hover:decoration-accent hover:text-accent"
        data-reset-filters
      >
        Filter zurücksetzen
      </button>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-grid>
      {faktenchecks.map((fc) => (
        <FaktencheckCard
          title={fc.data.title}
          faktenchecker={fc.data.faktenchecker}
          actorSlug={fc.data.actorSlug}
          slug={fc.id}
          date={fc.data.date}
          themen={fc.data.themen}
          behauptung={fc.data.behauptung}
          urteil={fc.data.urteil}
          realitaet={fc.data.realitaet}
          summary={fc.data.summary}
          thumbOverride={fc.data.thumbOverride}
          url={fc.data.url}
        />
      ))}
    </div>

    <p
      class="mt-10 text-center text-sm text-muted hidden"
      data-empty-state
    >
      Keine Faktenchecks passen zur Auswahl.
      <button type="button" class="underline text-accent" data-reset-filters>Filter zurücksetzen</button>.
    </p>

    <p class="mt-12 text-sm text-muted leading-relaxed max-w-2xl border-t border-line pt-6">
      Diese Übersicht ist eine Auswahl aus
      <a href="https://norberthaering.de/wahrheitskomplex/faktenchecks/" rel="noopener" class="underline decoration-line hover:decoration-accent">
        Härings Faktencheck-Sammlung
      </a>
      auf norberthaering.de. Wir verkürzen für die Karten-Form — wer das
      Argument prüfen will, sollte den jeweils verlinkten Tiefenartikel
      lesen.
    </p>
  </section>
</BaseLayout>

<script>
  let activeOutlet = '__all__';

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-faktencheck-card]'),
  );
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty-state]');
  const resetButtons = document.querySelectorAll<HTMLButtonElement>(
    '[data-reset-filters]',
  );

  function applyFilters() {
    let visible = 0;
    for (const card of cards) {
      const fc = card.dataset.faktenchecker ?? '';
      const show = activeOutlet === '__all__' || fc === activeOutlet;
      card.hidden = !show;
      if (show) visible++;
    }
    if (countEl) {
      countEl.textContent =
        visible === cards.length
          ? `${cards.length} Faktenchecks`
          : `${visible} von ${cards.length} Faktenchecks`;
    }
    if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const value = chip.dataset.filterValue ?? '__all__';
      activeOutlet = value;
      for (const c of chips) {
        const isActive = c === chip;
        c.classList.toggle('is-active', isActive);
        c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
      applyFilters();
    });
  }

  for (const btn of resetButtons) {
    btn.addEventListener('click', () => {
      activeOutlet = '__all__';
      for (const c of chips) {
        const isAllChip = c.dataset.filterValue === '__all__';
        c.classList.toggle('is-active', isAllChip);
        c.setAttribute('aria-pressed', isAllChip ? 'true' : 'false');
      }
      applyFilters();
    });
  }
</script>
