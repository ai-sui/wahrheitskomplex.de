---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FactWeek from '../components/FactWeek.astro';
import HookCard from '../components/HookCard.astro';
import BookSection from '../components/BookSection.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import MediaCard from '../components/MediaCard.astro';
import { factOfTheWeek, hookCards } from '../data/homepage';
import { book } from '../data/book';

const recent = (await getCollection('medien'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  alternateName: book.subtitle,
  author: {
    '@type': 'Person',
    name: book.author,
    url: 'https://norberthaering.de',
  },
  publisher: {
    '@type': 'Organization',
    name: book.publisher,
    url: book.buyUrl,
  },
  datePublished: '2026-05',
  inLanguage: 'de',
  description: book.blurb,
};
---

<BaseLayout title="Wahrheitskomplex" jsonLd={bookSchema}>
  <FactWeek fact={factOfTheWeek} />

  <section class="container-page py-12 md:py-16">
    <div class="flex items-baseline justify-between mb-8 border-b border-line pb-4">
      <h2 class="font-serif text-2xl md:text-3xl">Drei Einstiege</h2>
      <p class="meta-label hidden sm:block">aus dem Buch</p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {hookCards.map((card) => <HookCard card={card} />)}
    </div>
  </section>

  <section class="container-page py-12 md:py-16 border-t border-line">
    <div class="flex items-baseline justify-between mb-8 pb-4 border-b border-line">
      <h2 class="font-serif text-2xl md:text-3xl">Zuletzt im Gespräch</h2>
      <a
        href="/im-gespraech"
        class="text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        Alle Beiträge →
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {recent.map((m) => (
        <MediaCard
          title={m.data.title}
          type={m.data.type}
          host={m.data.host}
          outlet={m.data.outlet}
          url={m.data.url}
          youtubeId={m.data.youtubeId}
          slug={m.id}
          date={m.data.date}
          durationMin={m.data.durationMin}
          paywall={m.data.paywall}
          themen={m.data.themen}
          pullquote={m.data.pullquote}
          showEmbed={true}
        />
      ))}
    </div>
  </section>

  <BookSection book={book} />

  <NewsletterForm />
</BaseLayout>
