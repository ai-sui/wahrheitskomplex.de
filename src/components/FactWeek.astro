---
import type { FactOfTheWeek } from '../data/homepage';

interface Props {
  fact: FactOfTheWeek;
}

const { fact } = Astro.props;
---

<section class="container-page pt-10 md:pt-16 pb-10">
  <article class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start border-t border-line pt-8 max-w-5xl">
    <div>
      <p class="meta-label text-accent mb-3">{fact.kicker}</p>
      <p class="font-serif text-5xl md:text-6xl font-bold leading-none tracking-tight">
        {fact.number}
      </p>
    </div>

    <div class="md:pt-1">
      <h1 class="font-serif text-2xl md:text-3xl leading-[1.2] mb-5 font-semibold">
        <span class="text-muted">…</span>{fact.claim}
      </h1>

      <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm border-t border-line pt-5">
        <div>
          <dt class="meta-label mb-1">Quelle</dt>
          <dd class="text-ink-soft">{fact.source}</dd>
        </div>
        <div>
          <dt class="meta-label mb-1">Buch-Bezug</dt>
          <dd class="text-ink-soft">{fact.bookChapter}</dd>
        </div>
      </dl>

      <p class="mt-6">
        <a
          href={fact.deepLink.url}
          rel="noopener"
          class="inline-flex items-center gap-2 text-accent font-medium underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {fact.deepLink.label}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </article>
</section>
