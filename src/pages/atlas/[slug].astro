---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActorDetail from '../../components/ActorDetail.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const actors = await getCollection('actors', ({ data }) => data.fulltext);
  return actors.map((actor) => ({
    params: { slug: actor.id },
    props: { actor },
  }));
}

const { actor } = Astro.props;
const { Content } = await render(actor);

const description =
  actor.data.kurzbeschreibung ?? actor.data.kernkritik.slice(0, 160);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: actor.data.name,
  description: actor.data.kurzbeschreibung,
  foundingDate: actor.data.gegruendet ? String(actor.data.gegruendet) : undefined,
  address: {
    '@type': 'PostalAddress',
    addressCountry: actor.data.land,
  },
  sameAs: [actor.data.haeringLink, actor.data.libernetLink].filter(Boolean),
  funding: actor.data.finanzierung,
  subjectOf: {
    '@type': 'Book',
    name: 'Der Wahrheitskomplex',
    author: { '@type': 'Person', name: 'Norbert Häring' },
  },
};
---

<BaseLayout
  title={actor.data.name}
  description={description}
  ogImage={`/og/${actor.id}.png`}
  jsonLd={orgSchema}
>
  <nav class="container-page pt-8 text-sm">
    <a
      href={withBase('/atlas')}
      class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
    >
      ← Zur Übersicht
    </a>
  </nav>

  <ActorDetail
    name={actor.data.name}
    kategorie={actor.data.kategorie}
    akteurstyp={actor.data.akteurstyp}
    land={actor.data.land}
    gegruendet={actor.data.gegruendet}
    themen={actor.data.themen}
    finanzierung={actor.data.finanzierung}
    reichweite={actor.data.reichweite}
    kernkritik={actor.data.kernkritik}
    stellungnahme={actor.data.stellungnahme}
    buchKapitel={actor.data.buchKapitel}
    haeringLink={actor.data.haeringLink}
    libernetLink={actor.data.libernetLink}
    quellen={actor.data.quellen}
  >
    <Content />
  </ActorDetail>
</BaseLayout>
