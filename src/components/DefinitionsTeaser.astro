---
import DefinitionCard from './DefinitionCard.astro';
import { definitionen } from '../data/definitionen';
import { withBase } from '../utils/url';

// Norberts Linie: im Was-ist-Block werden nur Begriffe mit Volltext
// ausgespielt (also die mit eigener Detail-Seite). Kurz-Definitionen
// ohne Volltext bleiben im Glossar selbst, kommen hier nicht vor.
const tiefenchecks = definitionen.filter((d) => d.slug && d.volltext);
---

<section class="container-page py-10 md:py-14 border-t border-line">
  <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-line gap-4">
    <h2 class="font-serif text-2xl md:text-3xl leading-tight min-w-0">
      Was ist …
    </h2>
    <a
      href={withBase('/glossar')}
      class="hidden sm:inline-block text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent shrink-0 self-end"
    >
      Zum Glossar →
    </a>
  </div>

  <div
    class="grid gap-5 md:grid-cols-3"
    data-definitions-grid
  >
    {tiefenchecks.map((d, i) => (
      <div
        data-def-slot
        data-default-visible={i < 3 ? 'true' : 'false'}
        class:list={[i < 3 ? '' : 'hidden']}
      >
        <DefinitionCard d={d} />
      </div>
    ))}
  </div>
</section>

<script>
  // Beim Page-Load: erste Karte (Wahrheit) bleibt fix angezeigt,
  // zwei weitere werden zufaellig aus dem Rest gewaehlt.
  // Norberts Wunsch: 'Was ist Wahrheit?' ist Bezug zum Buchtitel und
  // soll immer als Einstieg da sein.
  // Ohne JS bleiben die ersten drei (default-visible) stehen.
  const grid = document.querySelector<HTMLElement>('[data-definitions-grid]');
  if (grid) {
    const slots = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-def-slot]'),
    );
    if (slots.length > 3) {
      // Slot 0 ist gepinnt. Aus den restlichen Indizes 2 zufaellig.
      const rest = slots.map((_, i) => i).slice(1);
      for (let i = rest.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [rest[i], rest[j]] = [rest[j], rest[i]];
      }
      const pick = new Set<number>([0, rest[0], rest[1]]);
      slots.forEach((slot, i) => {
        slot.classList.toggle('hidden', !pick.has(i));
      });
      // DOM-Reihenfolge: Slot 0 (Wahrheit) bleibt vorn, dann die zwei
      // zufaelligen, dann (versteckt) der Rest.
      const fragment = document.createDocumentFragment();
      const others: HTMLElement[] = [];
      fragment.appendChild(slots[0]);
      fragment.appendChild(slots[rest[0]]);
      fragment.appendChild(slots[rest[1]]);
      slots.forEach((slot, i) => {
        if (!pick.has(i)) others.push(slot);
      });
      others.forEach((s) => fragment.appendChild(s));
      grid.appendChild(fragment);
    }
  }
</script>
