---
import type { Book } from '../data/book';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<section class="container-page py-16 md:py-20">
  <div class="grid md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-start border-t border-line pt-12">
    <!-- Cover-Platzhalter (SVG, kein Asset nötig) -->
    <a
      href={book.buyUrl}
      rel="noopener"
      class="block w-44 md:w-52 shrink-0 mx-auto md:mx-0 group"
    >
      <svg
        viewBox="0 0 200 280"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto rounded-sm shadow-[0_15px_30px_-15px_rgba(26,26,26,0.35),0_5px_10px_-5px_rgba(26,26,26,0.15)] transition-transform group-hover:-translate-y-1"
        role="img"
        aria-labelledby="book-cover-title"
      >
        <title id="book-cover-title">{`Buchcover (Schmuck): ${book.title} — ${book.publisher}`}</title>
        <rect width="200" height="280" fill="#1a1a1a" />
        <rect x="14" y="14" width="172" height="252" fill="none" stroke="#b8331f" stroke-width="0.8" />

        <text x="100" y="58" text-anchor="middle" fill="#f5f1ea" font-family="Iowan Old Style, Palatino Linotype, Georgia, serif" font-size="11" letter-spacing="3" font-weight="600">NORBERT HÄRING</text>
        <line x1="40" y1="74" x2="160" y2="74" stroke="#b8331f" stroke-width="0.8" />

        <text x="100" y="135" text-anchor="middle" fill="#f5f1ea" font-family="Iowan Old Style, Palatino Linotype, Georgia, serif" font-size="22" font-weight="700">DER</text>
        <text x="100" y="165" text-anchor="middle" fill="#b8331f" font-family="Iowan Old Style, Palatino Linotype, Georgia, serif" font-size="22" font-weight="700" font-style="italic">Wahrheits-</text>
        <text x="100" y="190" text-anchor="middle" fill="#b8331f" font-family="Iowan Old Style, Palatino Linotype, Georgia, serif" font-size="22" font-weight="700" font-style="italic">komplex</text>

        <line x1="60" y1="220" x2="140" y2="220" stroke="#f5f1ea" stroke-width="0.4" opacity="0.5" />
        <text x="100" y="240" text-anchor="middle" fill="#f5f1ea" font-family="system-ui, sans-serif" font-size="8" letter-spacing="1.5" opacity="0.7">WESTEND VERLAG</text>
      </svg>
      <p class="mt-3 text-center text-xs text-muted">Schmuck-Cover, finales Cover folgt</p>
    </a>

    <div>
      <p class="meta-label text-accent mb-3">Das Buch</p>
      <h2 class="font-serif text-3xl md:text-4xl leading-tight mb-2">
        {book.title}
      </h2>
      <p class="font-serif italic text-lg md:text-xl text-ink-soft mb-5 leading-snug max-w-xl">
        {book.subtitle}
      </p>

      <p class="text-ink-soft leading-relaxed mb-6 max-w-xl">{book.blurb}</p>

      <dl class="grid grid-cols-[max-content_1fr] gap-x-5 gap-y-2 text-sm border-y border-line py-4 mb-6 max-w-md">
        <dt class="meta-label">Autor</dt>
        <dd>{book.author}</dd>
        <dt class="meta-label">Verlag</dt>
        <dd>{book.publisher}</dd>
        <dt class="meta-label">Erscheinen</dt>
        <dd>{book.publicationDate}</dd>
      </dl>

      <p class="text-sm text-ink-soft leading-relaxed mb-6 max-w-xl">
        <span class="meta-label text-muted block mb-1.5">Über den Autor</span>
        {book.authorBio}
      </p>

      {book.buyUrl && (
        <a
          href={book.buyUrl}
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-ink px-5 py-2.5 text-sm font-medium no-underline hover:bg-ink hover:text-paper transition-colors"
        >
          Beim Westend Verlag <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</section>
