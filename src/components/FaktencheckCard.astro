---
import { thumbManifest } from '../data/thumb-manifest';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  faktenchecker: string;
  actorSlug?: string;
  slug: string;
  date: string;
  themen?: string[];
  behauptung?: string;
  urteil?: string;
  realitaet?: string;
  summary?: string;
  url: string;
  thumbOverride?: string;
}

const {
  title,
  faktenchecker,
  actorSlug,
  slug,
  date,
  themen = [],
  behauptung,
  urteil,
  realitaet,
  summary,
  url,
  thumbOverride,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(date));

// Thumb-Logik: override hat Vorrang vor automatischem og:image.
// Existenz-Check läuft über das Build-Manifest (kein node:fs zur Render-Zeit).
let thumb: string | null = null;
if (thumbOverride) {
  thumb = withBase(thumbOverride);
} else if (thumbManifest.faktencheckThumbs.includes(`${slug}.jpg`)) {
  thumb = withBase(`/faktencheck-thumbs/${slug}.jpg`);
}

const hasSummary = Boolean(summary);
const hasThreeBlocks = Boolean(behauptung && urteil && realitaet);
---

<article
  id={slug}
  class="relative bg-paper-soft border border-line rounded-sm overflow-hidden flex flex-col scroll-mt-32 group transition-colors hover:border-accent"
  data-faktencheck-card
  data-faktenchecker={faktenchecker}
  data-themen={themen.join('|')}
>
  {/*
    Norbert (Mail 11.6.2026): „Die Links in den Karton ... sind nicht aktiv."
    Lösung: Stretched-Link-Pattern. Der Titel-Link unten bekommt via
    `after:absolute after:inset-0` ein Pseudoelement, das die ganze Karte
    abdeckt. Damit ist jeder Klick auf die Karte ein Klick auf den Titel-Link.
    Sekundäre Links (Akteurs-Porträt) bekommen `relative z-10`, damit sie
    weiterhin separat funktionieren.
  */}
  {thumb ? (
    <div class="block aspect-video bg-ink relative overflow-hidden">
      <img
        src={thumb}
        alt={`Vorschau: ${title}`}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-ink/15 to-transparent"></div>
      <span class="absolute top-3 left-3 text-[0.65rem] uppercase tracking-wider bg-paper/95 text-ink px-2 py-0.5 rounded-full">
        {faktenchecker}
      </span>
      <span class="absolute bottom-3 right-3 text-[0.65rem] uppercase tracking-wider bg-paper/95 text-ink px-2 py-0.5 rounded-full">
        Tiefenartikel ↗
      </span>
    </div>
  ) : (
    <a
      href={url}
      rel="noopener"
      target="_blank"
      class="block aspect-video bg-ink relative overflow-hidden no-underline group"
      aria-label={`Tiefenartikel auf norberthaering.de: ${title}`}
    >
      {/* Fallback ohne Aufmacherbild. Aus Copyright-Grunden hosten wir
          keine Agenturbilder mehr; wo kein eigenes Bild vorliegt, wird
          diese typografische Karte gerendert. Statt nur zentrierter
          Faktenchecker-Name jetzt eine ruhige Text-Komposition:
          Sektions-Label oben, grosser Faktenchecker-Name mittig, Datum
          unten. Sanfter Akzent-Verlauf oben rechts fuer Textur, aber
          ohne bunt zu wirken. */}
      <div class="absolute inset-0 bg-gradient-to-br from-accent/25 via-transparent to-transparent"></div>
      <div class="absolute inset-0 flex flex-col justify-between p-5 md:p-6">
        <p class="text-[0.65rem] uppercase tracking-wider text-paper/60">
          Faktenchecker-Check
        </p>
        <p class="font-serif text-2xl md:text-3xl leading-tight text-paper text-balance">
          {faktenchecker}
        </p>
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-[0.65rem] uppercase tracking-wider text-paper/60">
            {dateFmt}
          </p>
          <span class="text-[0.65rem] uppercase tracking-wider bg-paper/95 text-ink px-2 py-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
            Tiefenartikel ↗
          </span>
        </div>
      </div>
    </a>
  )}

  <div class="p-5 md:p-6 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3 text-xs flex-wrap">
      {/* Dachzeile auf Norberts Vorschlag vom 24.5.2026:
          "Sollten wir die Dachzeile vielleicht jeweils in
          Faktenchecker-Check ändern?" — ja, weil die Sektion
          ebenfalls so heisst und damit pro Karte konsistent ist. */}
      <span class="meta-label text-accent">Faktenchecker-Check</span>
      <span class="text-muted">·</span>
      <time class="text-muted" datetime={date}>{dateFmt}</time>
    </div>

    <h3 class="font-serif text-lg md:text-xl leading-snug mb-4">
      <a
        href={url}
        rel="noopener" target="_blank"
        class="no-underline group-hover:text-accent transition-colors after:absolute after:inset-0 after:content-['']"
      >
        {title}
      </a>
    </h3>

    {hasSummary ? (
      <p class="text-sm text-ink-soft leading-relaxed">{summary}</p>
    ) : hasThreeBlocks ? (
      <dl class="grid gap-3 text-sm">
        <div>
          <dt class="meta-label text-muted mb-1">Behauptung</dt>
          <dd class="text-ink-soft leading-snug">{behauptung}</dd>
        </div>
        <div>
          <dt class="meta-label text-muted mb-1">Urteil von {faktenchecker}</dt>
          <dd class="text-ink-soft leading-snug">{urteil}</dd>
        </div>
        <div>
          <dt class="meta-label text-accent mb-1">Was die Recherche zeigt</dt>
          <dd class="text-ink leading-snug">{realitaet}</dd>
        </div>
      </dl>
    ) : null}

    <div class="mt-auto pt-4 border-t border-line flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {/*
        Der „Vollständiger Beitrag"-Text bleibt sichtbar als Hinweis,
        kein eigener <a>-Tag mehr — der Stretched-Link am Titel deckt
        ihn ohnehin ab. Akteur-Link sitzt mit relative z-10 darüber.
      */}
      <span class="text-accent font-medium underline decoration-accent/40 underline-offset-4">
        Vollständiger Beitrag bei norberthaering.de →
      </span>
      {actorSlug && (
        <a
          href={withBase(`/portraits/${actorSlug}`)}
          class="relative z-10 text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
        >
          Im Porträt →
        </a>
      )}
    </div>

    {themen.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4">
        {themen.map((t) => (
          <span class="text-[0.65rem] uppercase tracking-wider px-2 py-0.5 bg-paper border border-line rounded-full text-muted">
            {t}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
