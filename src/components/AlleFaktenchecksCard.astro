---
// Schlusskachel im Faktenchecks-Karussell. Lädt zur Vollübersicht
// /faktenchecks ein — sichtbar erst, wenn der Leser sich durch das
// Karussell gescrollt hat. Bewusst analog zur SpinnenImNetzCard
// gestaltet (dunkel, gleicher Anker am Ende).
import { withBase } from '../utils/url';

interface Props {
  count: number;
}

const { count } = Astro.props;
---

<a
  href={withBase('/faktenchecks')}
  class="group h-full flex flex-col bg-ink text-paper border border-ink rounded-sm p-6 md:p-7 no-underline transition-colors hover:bg-accent hover:border-accent"
>
  <p class="meta-label text-paper/70 mb-4">Übersicht</p>

  <h3 class="font-serif text-xl md:text-2xl leading-tight mb-3">
    Alle {count} Faktenchecks ansehen
  </h3>

  <p class="text-sm text-paper/85 leading-relaxed flex-1 mb-5">
    Vollständige Liste, gefiltert nach Faktenchecker — von ARD, Correctiv,
    dpa, AFP, ZDF und Tagesschau.
  </p>

  <p class="text-sm text-paper/95 font-medium border-t border-paper/30 pt-4 mt-auto">
    Zur Übersicht <span class="inline-block ml-1" aria-hidden="true">→</span>
  </p>
</a>
