---
// Privacy-friendly YouTube embed.
// Lädt nur ein lokal gehostetes Thumbnail. Erst nach Klick wird das Iframe
// (über youtube-nocookie.com) eingefügt. Keine Drittanbieter-Requests
// vor Interaktion.
import { withBase } from '../utils/url';

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<lite-youtube
  data-id={id}
  data-title={title}
  class="block relative w-full aspect-video bg-ink cursor-pointer overflow-hidden rounded-sm"
  tabindex="0"
  role="button"
  aria-label={`Video abspielen: ${title}`}
>
  <img
    src={withBase(`/yt-thumbs/${id}.jpg`)}
    alt={`Vorschau: ${title}`}
    width="1280"
    height="720"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover opacity-95"
  />
  <div class="absolute inset-0 flex items-center justify-center">
    <svg
      viewBox="0 0 68 48"
      aria-hidden="true"
      class="w-16 md:w-20 h-auto drop-shadow-lg"
    >
      <path
        d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,0.13,34,0,34,0S12.21,0.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
        fill="#b8331f"
        fill-opacity="0.95"
      />
      <path d="M 45,24 27,14 27,34" fill="#f5f1ea" />
    </svg>
  </div>
  <p class="absolute bottom-2 left-2 right-2 text-paper text-xs opacity-80 line-clamp-1 px-2">
    Klick lädt YouTube · keine Tracker vorher
  </p>
</lite-youtube>

<script>
  class LiteYouTube extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', () => this.activate());
      this.addEventListener('keydown', (e) => {
        if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
          e.preventDefault();
          this.activate();
        }
      });
    }
    activate() {
      const id = this.dataset.id;
      const title = this.dataset.title ?? 'YouTube-Video';
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute(
        'allow',
        'accelerometer; encrypted-media; gyroscope; picture-in-picture',
      );
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('title', title);
      iframe.setAttribute('loading', 'eager');
      iframe.setAttribute(
        'src',
        `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`,
      );
      iframe.className = 'absolute inset-0 w-full h-full';
      this.innerHTML = '';
      this.appendChild(iframe);
      this.removeAttribute('tabindex');
      this.removeAttribute('role');
    }
  }
  if (!customElements.get('lite-youtube')) {
    customElements.define('lite-youtube', LiteYouTube);
  }
</script>
