---
import type { ChronikEintrag } from '../data/chronik';
import { withBase } from '../utils/url';

interface Props {
  eintrag: ChronikEintrag;
  showLine?: boolean;
  // versteckt Description und Themen-Tags. Auf der Homepage-Übersicht
  // war das schon immer Default. Auf der Chronik-Seite zusätzlich seit
  // Norberts Hinweis vom 20.5.2026: "ohne magere Unterzeile und
  // Schlagwörter. Dann wird das kompakter und der Leser braucht sich
  // nicht durch mehrere Ebenen zu lesen, um einen Überblick zu bekommen."
  compact?: boolean;
}

const { eintrag, showLine = true, compact = false } = Astro.props;

// Format date based on precision
const parts = eintrag.date.split('-');
let dateLabel = '';
let dateAttr = eintrag.date;
if (parts.length === 3) {
  dateLabel = new Intl.DateTimeFormat('de-DE', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(eintrag.date));
} else if (parts.length === 2) {
  const monthName = new Intl.DateTimeFormat('de-DE', {
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${eintrag.date}-15`));
  dateLabel = monthName;
  dateAttr = `${eintrag.date}-01`;
} else {
  dateLabel = parts[0];
  dateAttr = `${parts[0]}-01-01`;
}
---

<article
  class="grid md:grid-cols-[10rem_1fr] gap-4 md:gap-8 relative"
  data-timeline-event
  data-themen={(eintrag.themen ?? []).join('|')}
  data-date={eintrag.date}
>
  <!-- Datum / Marker -->
  <div class="md:text-right relative">
    <time
      datetime={dateAttr}
      class="meta-label text-accent inline-block"
    >
      {dateLabel}
    </time>
  </div>

  <!-- Content + Linie -->
  <div class="relative pl-6 md:pl-8 pb-10 md:pb-12">
    {showLine && (
      <div class="absolute left-0 md:left-0 top-1.5 bottom-0 w-px bg-line" aria-hidden="true"></div>
    )}
    <div class="absolute left-[-4px] md:left-[-4px] top-2 w-2 h-2 rounded-full bg-accent ring-4 ring-paper" aria-hidden="true"></div>

    <h3 class="font-serif text-lg md:text-xl leading-snug mb-2">
      {eintrag.title}
    </h3>
    {eintrag.thumb && (
      <figure class="mb-3 max-w-md">
        <img
          src={withBase(eintrag.thumb)}
          alt=""
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded border border-line bg-paper"
        />
        {eintrag.imageCredit && (
          <figcaption class="mt-1 text-xs text-muted">
            {eintrag.imageCreditUrl ? (
              <a
                href={eintrag.imageCreditUrl}
                rel="noopener nofollow"
                target="_blank"
                class="underline decoration-line hover:decoration-accent hover:text-accent"
              >
                {eintrag.imageCredit}
              </a>
            ) : (
              eintrag.imageCredit
            )}
          </figcaption>
        )}
      </figure>
    )}
    {!compact && eintrag.description && (
      <p class="text-ink-soft leading-relaxed mb-3 max-w-2xl">
        {eintrag.description}
      </p>
    )}

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {eintrag.actorSlug && (
        <a
          href={withBase(`/portraits/${eintrag.actorSlug}`)}
          class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          Im Porträt →
        </a>
      )}
      {eintrag.haeringLink && (
        <a
          href={eintrag.haeringLink}
          rel="noopener" target="_blank"
          class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
        >
          norberthaering.de →
        </a>
      )}
      {eintrag.sourceLink && (
        <a
          href={eintrag.sourceLink}
          rel="noopener" target="_blank"
          class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
        >
          Beleg →
        </a>
      )}
    </div>

  </div>
</article>
