---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  title: string;
  faktenchecker: string;
  actorSlug?: string;
  slug: string;
  date: string;
  themen?: string[];
  behauptung: string;
  urteil: string;
  realitaet: string;
  url: string;
}

const {
  title,
  faktenchecker,
  actorSlug,
  slug,
  date,
  themen = [],
  behauptung,
  urteil,
  realitaet,
  url,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(date));

const thumbPath = resolve(
  process.cwd(),
  `public/faktencheck-thumbs/${slug}.jpg`,
);
const thumb = existsSync(thumbPath) ? `/faktencheck-thumbs/${slug}.jpg` : null;
---

<article
  id={slug}
  class="bg-paper-soft border border-line rounded-sm overflow-hidden flex flex-col scroll-mt-32"
  data-faktencheck-card
  data-faktenchecker={faktenchecker}
  data-themen={themen.join('|')}
>
  {thumb ? (
    <a
      href={url}
      rel="noopener"
      class="block aspect-video bg-ink relative overflow-hidden group no-underline"
      aria-label={`Tiefenartikel auf norberthaering.de: ${title}`}
    >
      <img
        src={thumb}
        alt={`Vorschau: ${title}`}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-ink/15 to-transparent"></div>
      <span class="absolute top-3 left-3 text-[0.65rem] uppercase tracking-wider bg-paper/95 text-ink px-2 py-0.5 rounded-full">
        {faktenchecker}
      </span>
      <span class="absolute bottom-3 right-3 text-[0.65rem] uppercase tracking-wider bg-paper/95 text-ink px-2 py-0.5 rounded-full">
        Tiefenartikel ↗
      </span>
    </a>
  ) : (
    <a
      href={url}
      rel="noopener"
      class="block aspect-video bg-ink relative no-underline"
    >
      <div class="absolute inset-0 flex items-center justify-center text-paper/80 font-serif text-xl px-6 text-center">
        {faktenchecker}
      </div>
    </a>
  )}

  <div class="p-5 md:p-6 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3 text-xs flex-wrap">
      <span class="meta-label text-accent">Faktencheck</span>
      <span class="text-muted">·</span>
      <time class="text-muted" datetime={date}>{dateFmt}</time>
    </div>

    <h3 class="font-serif text-lg md:text-xl leading-snug mb-4">
      <a href={url} rel="noopener" class="no-underline hover:text-accent">
        {title}
      </a>
    </h3>

    <dl class="grid gap-3 text-sm flex-1">
      <div>
        <dt class="meta-label text-muted mb-1">Behauptung</dt>
        <dd class="text-ink-soft leading-snug">{behauptung}</dd>
      </div>
      <div>
        <dt class="meta-label text-muted mb-1">Urteil von {faktenchecker}</dt>
        <dd class="text-ink-soft leading-snug">{urteil}</dd>
      </div>
      <div>
        <dt class="meta-label text-accent mb-1">Was Härings Recherche zeigt</dt>
        <dd class="text-ink leading-snug">{realitaet}</dd>
      </div>
    </dl>

    <div class="mt-5 pt-4 border-t border-line flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <a
        href={url}
        rel="noopener"
        class="text-accent font-medium underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        Vollständiger Beitrag →
      </a>
      {actorSlug && (
        <a
          href={`/atlas/${actorSlug}`}
          class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
        >
          Akteur im Atlas →
        </a>
      )}
    </div>

    {themen.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4">
        {themen.map((t) => (
          <span class="text-[0.65rem] uppercase tracking-wider px-2 py-0.5 bg-paper border border-line rounded-full text-muted">
            {t}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
