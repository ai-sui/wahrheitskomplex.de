---
import { withBase } from '../utils/url';

interface Props {
  name: string;
  slug: string;
  kategorie: string;
  land: string;
  gegruendet?: string | number;
  kurzbeschreibung: string;
}

const { name, slug, kategorie, land, gegruendet, kurzbeschreibung } = Astro.props;

const metaLine = [kategorie, land, gegruendet]
  .filter((s) => s !== undefined && s !== '')
  .join(' · ');
---

<a
  href={withBase(`/atlas/${slug}`)}
  class="group h-full flex flex-col bg-paper-soft border border-line border-l-4 border-l-accent rounded-sm p-6 md:p-7 no-underline transition-colors hover:border-accent"
>
  <p class="meta-label text-muted mb-4 leading-tight">{metaLine}</p>

  <h3 class="font-serif text-xl md:text-2xl leading-tight mb-3 group-hover:text-accent transition-colors">
    {name}
  </h3>

  <p class="text-sm text-ink-soft leading-relaxed flex-1 mb-5">
    {kurzbeschreibung}
  </p>

  <p class="text-sm text-accent font-medium border-t border-line pt-4 mt-auto">
    Profil ansehen →
  </p>
</a>
