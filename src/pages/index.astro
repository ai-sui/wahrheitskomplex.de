---
import BaseLayout from '../layouts/BaseLayout.astro';
import FactWeek from '../components/FactWeek.astro';
import HookCard from '../components/HookCard.astro';
import BookSection from '../components/BookSection.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { factOfTheWeek, hookCards } from '../data/homepage';
import { book } from '../data/book';

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  alternateName: book.subtitle,
  author: {
    '@type': 'Person',
    name: book.author,
    url: 'https://norberthaering.de',
  },
  publisher: {
    '@type': 'Organization',
    name: book.publisher,
    url: book.buyUrl,
  },
  datePublished: '2026',
  inLanguage: 'de',
  description: book.blurb,
};
---

<BaseLayout title="Wahrheitskomplex" jsonLd={bookSchema}>
  <FactWeek fact={factOfTheWeek} />

  <section class="container-page py-12 md:py-16">
    <div class="flex items-baseline justify-between mb-8 border-b border-line pb-4">
      <h2 class="font-serif text-2xl md:text-3xl">Drei Einstiege</h2>
      <p class="meta-label hidden sm:block">aus dem Buch</p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {hookCards.map((card) => <HookCard card={card} />)}
    </div>
  </section>

  <BookSection book={book} />

  <NewsletterForm />
</BaseLayout>
