---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { kapitel } from '../data/buch';
import { recherchen } from '../data/recherchen';
import { book } from '../data/book';
import { withBase } from '../utils/url';
import { breadcrumbList } from '../utils/seo';

const actors = await getCollection('actors');

const bc = breadcrumbList(Astro.site, [{ name: 'Das Buch', path: '/buch' }]);

function actorsFor(matches: string) {
  return actors
    .filter((a) => a.data.buchKapitel?.includes(matches) && a.data.fulltext)
    .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
}

function recherchenFor(matches: string) {
  return recherchen.filter((r) => r.buchKapitel?.includes(matches));
}
---

<BaseLayout
  title="Das Buch"
  description="Sechs Kapitel von „Der Wahrheitskomplex“ — Inhalt, Akteure, Recherche-Beispiele. Mit direkten Verweisen ins Inhaltsverzeichnis und die Leseprobe auf norberthaering.de."
  jsonLd={bc}
>
  <section class="container-page py-12 md:py-16 max-w-4xl">
    <p class="meta-label text-accent mb-3">Das Buch</p>
    <h1 class="font-serif text-3xl md:text-4xl leading-tight mb-4">
      {book.title} — in sechs Kapiteln.
    </h1>
    <p class="text-ink-soft text-lg leading-relaxed max-w-2xl mb-8">
      Eine kompakte Karte des Buchs: Worum geht es in welchem Kapitel, welche
      Akteure im Porträt tauchen wo auf, welche Recherche-Beispiele sind
      thematisch verbunden.
    </p>

    <div class="flex flex-wrap gap-3 mb-12">
      <a
        href="https://norberthaering.de/wahrheitskomplex/inhaltsverzeichnis/"
        rel="noopener" target="_blank"
        class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors"
      >
        Vollständiges Inhaltsverzeichnis →
      </a>
      <a
        href="https://norberthaering.de/buchtipps/wahrheitskonplex-leseprobe/"
        rel="noopener" target="_blank"
        class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors"
      >
        Leseprobe →
      </a>
      <a
        href={book.buyUrl}
        rel="noopener" target="_blank"
        class="inline-flex items-center gap-2 rounded-full bg-ink text-paper px-5 py-2.5 text-sm font-medium no-underline hover:bg-accent transition-colors"
      >
        Beim Westend Verlag →
      </a>
    </div>

    {/* Kapitel-Schnellnavigation. Grid mit symmetrischen Spalten,
        damit die linke und rechte Spalte gleich breit sind und der
        Eindruck nicht "verschoben" wirkt (Ralph 25.5.). */}
    <nav aria-label="Kapitel-Übersicht" class="border-y border-line py-5 mb-10">
      <p class="meta-label mb-3">Springen zu</p>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5 text-sm">
        {kapitel.map((k) => (
          <li>
            <a
              href={`#kapitel-${k.nr}`}
              class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
            >
              <span class="meta-label text-muted mr-1">{k.nr}</span>
              {k.title}
            </a>
          </li>
        ))}
      </ol>

    </nav>

    {/* Weiterführende externe Quellen aus allen Kapiteln als
        eigene, prominente Box direkt unter der Schnellnavigation
        (Ralph 25.5.: "ich finde kein weiterfuehrend auf der seite").
        Eigener Hintergrund, links farbiger Border und mehr Padding,
        damit der Block sich klar absetzt. */}
    {kapitel.some((k) => k.weiterfuehrend && k.weiterfuehrend.length > 0) && (
      <aside class="mb-10 rounded-sm border border-line border-l-4 border-l-accent bg-paper-soft p-5">
        <p class="meta-label text-accent mb-3">Weiterführend</p>
        <ul class="space-y-2 text-sm">
          {kapitel.flatMap((k) =>
            (k.weiterfuehrend ?? []).map((w) => (
              <li>
                <a
                  href={w.url}
                  rel="noopener"
                  target="_blank"
                  class="font-serif text-base text-ink no-underline hover:text-accent"
                >
                  {w.label} ↗
                </a>
                <span class="text-muted ml-2 text-xs">· Kap. {k.nr}</span>
                {w.beschreibung && (
                  <p class="text-ink-soft leading-snug mt-1">{w.beschreibung}</p>
                )}
              </li>
            )),
          )}
        </ul>
      </aside>
    )}

    <div class="space-y-16">
      {kapitel.map((k) => {
        const actorList = actorsFor(k.matches);
        const recherchenList = recherchenFor(k.matches);
        return (
          <article id={`kapitel-${k.nr}`} class="scroll-mt-32">
            <div class="flex items-baseline gap-4 mb-4">
              <span class="font-serif text-5xl md:text-6xl font-bold text-accent leading-none">
                {String(k.nr).padStart(2, '0')}
              </span>
              <h2 class="font-serif text-2xl md:text-3xl leading-tight">
                {k.title}
              </h2>
            </div>

            <p class="text-ink-soft leading-relaxed max-w-2xl mb-6 md:ml-20">
              {k.abstract}
            </p>

            <div class="md:ml-20 grid md:grid-cols-[2fr_3fr] gap-8 md:gap-12">
              <div>
                <p class="meta-label text-muted mb-3">Unterabschnitte</p>
                <ul class="space-y-1.5 text-sm text-ink-soft border-l border-line pl-4">
                  {k.unterabschnitte.map((u) => (
                    <li>{u}</li>
                  ))}
                </ul>
              </div>

              <div class="space-y-6">
                {actorList.length > 0 && (
                  <div>
                    <p class="meta-label text-accent mb-3">
                      Akteure im Porträt
                    </p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm">
                      {actorList.map((a) => (
                        <li>
                          <a
                            href={withBase(`/portraits/${a.id}`)}
                            class="text-ink no-underline hover:text-accent border-b border-line hover:border-accent inline-block"
                          >
                            {a.data.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {recherchenList.length > 0 && (
                  <div>
                    <p class="meta-label text-accent mb-3">
                      Recherche-Beispiele
                    </p>
                    <ul class="space-y-2 text-sm">
                      {recherchenList.map((r) => (
                        <li>
                          <a
                            href={withBase(`/recherchen#${r.slug}`)}
                            class="text-ink-soft no-underline hover:text-accent leading-snug block"
                          >
                            <span class="text-accent">›</span> {r.frage}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {k.weiterfuehrend && k.weiterfuehrend.length > 0 && (
                  <div>
                    <p class="meta-label text-accent mb-3">Weiterführend</p>
                    <ul class="space-y-2 text-sm">
                      {k.weiterfuehrend.map((w) => (
                        <li>
                          <a
                            href={w.url}
                            rel="noopener"
                            target="_blank"
                            class="text-ink-soft no-underline hover:text-accent leading-snug block"
                          >
                            <span class="text-accent">›</span> {w.label} ↗
                          </a>
                          {w.beschreibung && (
                            <p class="text-xs text-muted leading-snug pl-3 mt-1">
                              {w.beschreibung}
                            </p>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {actorList.length === 0 &&
                  recherchenList.length === 0 &&
                  (!k.weiterfuehrend || k.weiterfuehrend.length === 0) && (
                    <p class="text-sm text-muted italic">
                      Porträte und Recherchen zu diesem Kapitel folgen.
                    </p>
                  )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/*
      Flyer-Block (Norbert-Mail vom 23.6.2026). Westend stellt einen
      Flyer zum Buch kostenlos zur Verfügung, der per Mail bestellt
      werden kann. Vorder- und Rückseite werden hier als Vorschau
      gezeigt, plus ein PDF zum direkten Download.
    */}
    <section class="mt-16 rounded-sm border border-line border-l-4 border-l-accent bg-paper-soft p-6 md:p-8">
      <p class="meta-label text-accent mb-3">Mitnehmen, weitergeben</p>
      <h2 class="font-serif text-2xl md:text-3xl mb-4">Flyer zum Buch</h2>
      <div class="grid md:grid-cols-[1fr_auto] gap-8 items-start">
        <div class="text-ink-soft leading-relaxed">
          <p class="mb-4">
            Wenn Sie Ihre Mitmenschen über das Buch „Der Wahrheitskomplex"
            von Norbert Häring informieren möchten, können Sie unter der
            Mailadresse
            {' '}
            <a
              href="mailto:gruenhagen@westendverlag.de?subject=Flyer%20Der%20Wahrheitskomplex"
              class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
            >
              gruenhagen@westendverlag.de
            </a>
            {' '}
            kostenlos den rechts abgebildeten Flyer beziehen. Bitte geben Sie
            an, wie viele Exemplare Sie sinnvoll zu diesem Zweck verwenden
            können.
          </p>
          <p>
            <a
              href={withBase('/buch-flyer-wahrheitskomplex.pdf')}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors"
            >
              Flyer als PDF (388 KB) ↓
            </a>
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 md:max-w-xs">
          <figure class="m-0">
            <img
              src={withBase('/buch-flyer-vorderseite.jpg')}
              alt="Flyer „Der Wahrheitskomplex", Vorderseite"
              width="315"
              height="453"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-sm border border-line"
            />
            <figcaption class="mt-1 text-[0.65rem] uppercase tracking-wider text-muted text-center">
              Vorderseite
            </figcaption>
          </figure>
          <figure class="m-0">
            <img
              src={withBase('/buch-flyer-rueckseite.jpg')}
              alt="Flyer „Der Wahrheitskomplex", Rückseite"
              width="315"
              height="453"
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-sm border border-line"
            />
            <figcaption class="mt-1 text-[0.65rem] uppercase tracking-wider text-muted text-center">
              Rückseite
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <p class="mt-16 text-sm text-muted leading-relaxed border-t border-line pt-6">
      Diese Übersicht ist eine vereinfachte Karte des Buchs — sie ersetzt
      nicht die Lektüre. Für vollständige Unterabschnitte siehe das
      <a href="https://norberthaering.de/wahrheitskomplex/inhaltsverzeichnis/" rel="noopener" target="_blank" class="underline decoration-line hover:decoration-accent">
        offizielle Inhaltsverzeichnis
      </a>
      auf norberthaering.de.
    </p>
  </section>
</BaseLayout>
