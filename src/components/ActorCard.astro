---
interface Props {
  name: string;
  slug: string;
  kategorie: string;
  akteurstyp: string;
  land: string;
  themen: string[];
  kurzbeschreibung: string;
  fulltext: boolean;
}

const { name, slug, kategorie, akteurstyp, land, themen, kurzbeschreibung, fulltext } =
  Astro.props;

const themenAttr = themen.join('|');
---

<article
  class="group flex flex-col bg-paper-soft border border-line rounded-sm p-6 transition-colors hover:border-accent"
  data-actor-card
  data-akteurstyp={akteurstyp}
  data-themen={themenAttr}
>
  <div class="flex items-baseline justify-between gap-3 mb-3">
    <p class="meta-label text-accent">{kategorie}</p>
    <p class="text-xs text-muted">{land}</p>
  </div>

  <h3 class="font-serif text-xl md:text-2xl leading-snug mb-3 group-hover:text-accent transition-colors">
    {fulltext ? (
      <a href={`/atlas/${slug}`} class="no-underline">{name}</a>
    ) : (
      <span>{name}</span>
    )}
  </h3>

  <p class="text-sm text-ink-soft leading-relaxed mb-5 flex-1">{kurzbeschreibung}</p>

  <div class="flex flex-wrap gap-1.5 mb-4">
    {themen.map((thema) => (
      <span class="text-[0.65rem] uppercase tracking-wider px-2 py-0.5 bg-paper border border-line rounded-full text-muted">
        {thema}
      </span>
    ))}
  </div>

  <p class="meta-label text-muted border-t border-line pt-3 mt-auto">
    {fulltext ? (
      <a href={`/atlas/${slug}`} class="text-accent no-underline hover:underline">
        Profil ansehen →
      </a>
    ) : (
      <span>Profil folgt</span>
    )}
  </p>
</article>
