---
import { withBase } from '../utils/url';
const year = new Date().getFullYear();
---

{/* mt-0 statt mt-24 (Ralph 25.5.: zwischen Newsletter und Footer
    war ein heller bg-paper-Streifen sichtbar, weil Newsletter und
    Footer beide bg-paper-soft haben und der Margin den Body-
    Hintergrund durchschimmern liess). Den Atem vor dem Footer
    geben jetzt die einzelnen Pages mit dem Padding ihrer letzten
    Section bzw. die NewsletterForm mit eigenem mt-20. */}
<footer class="border-t border-line bg-paper-soft">
  <div class="container-page py-12 grid gap-10 md:grid-cols-3 text-sm">
    <div>
      <p class="font-serif text-lg font-semibold mb-2">Wahrheits<span class="text-accent">komplex</span></p>
      <p class="text-ink-soft leading-relaxed">
        Begleitseite mit Porträts, Faktenchecks und Chronik zum Buch <em>Der Wahrheitskomplex</em> von Norbert Häring (Westend Verlag, 2026).
      </p>
    </div>

    <div>
      <p class="meta-label mb-3">Navigation</p>
      <ul class="space-y-2 text-ink-soft">
        <li><a href={withBase('/')} class="hover:text-accent">Start</a></li>
        <li><a href={withBase('/buch')} class="hover:text-accent">Das Buch</a></li>
        <li><a href={withBase('/portraits')} class="hover:text-accent">Porträts der Akteure</a></li>
        <li><a href={withBase('/faktenchecks')} class="hover:text-accent">Faktenchecks</a></li>
        <li><a href={withBase('/chronik')} class="hover:text-accent">Chronik</a></li>
        <li><a href={withBase('/recherchen')} class="hover:text-accent">Recherchen</a></li>
        <li><a href={withBase('/im-gespraech')} class="hover:text-accent">Im Gespräch</a></li>
        <li><a href={withBase('/glossar')} class="hover:text-accent">Glossar</a></li>
        <li><a href={withBase('/ueber')} class="hover:text-accent">Über das Projekt</a></li>
        <li><a href="https://norberthaering.de" rel="noopener" target="_blank" class="hover:text-accent">norberthaering.de &rarr;</a></li>
      </ul>
    </div>

    <div>
      <p class="meta-label mb-3">Rechtliches</p>
      <ul class="space-y-2 text-ink-soft">
        <li><a href={withBase('/impressum')} class="hover:text-accent">Impressum</a></li>
        <li><a href={withBase('/datenschutz')} class="hover:text-accent">Datenschutz</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page py-5 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-xs text-muted">
      <p>&copy; {year} Wahrheitskomplex. Begleitseite zum Buch von Norbert Häring.</p>
      <p>Keine Tracker. Keine Webfonts. Keine Analytics.</p>
    </div>
  </div>
</footer>
