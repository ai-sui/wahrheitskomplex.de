---
// Client-seitige Suche. Lädt /search-index.json beim ersten Öffnen,
// filtert clientseitig, keine externen Requests.
---

<dialog
  id="search-dialog"
  class="m-0 w-full max-w-2xl p-0 bg-paper border border-line rounded-sm shadow-2xl
         fixed top-[10vh] left-1/2 -translate-x-1/2 max-h-[80vh]
         backdrop:bg-ink/50 backdrop:backdrop-blur-sm"
  aria-labelledby="search-title"
>
  <form id="search-form" class="flex flex-col max-h-[80vh]" method="dialog">
    <header class="flex items-center gap-3 p-4 border-b border-line">
      <svg viewBox="0 0 24 24" width="20" height="20" class="text-muted shrink-0" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <label for="search-input" class="sr-only" id="search-title">Suche im Wahrheitskomplex</label>
      <input
        id="search-input"
        type="search"
        placeholder="Stichwort, Akteur, Begriff…"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent border-0 outline-none text-base md:text-lg placeholder:text-muted"
      />
      <button
        type="button"
        class="text-xs text-muted px-2 py-1 border border-line rounded hover:border-accent hover:text-accent shrink-0"
        data-close
        aria-label="Schließen"
      >
        Esc
      </button>
    </header>

    <div
      id="search-results"
      class="overflow-y-auto p-2 flex-1 min-h-0"
      role="listbox"
      aria-label="Suchergebnisse"
    >
      <div class="p-4 text-sm text-muted" data-empty-prompt>
        <p class="mb-2">Probieren Sie zum Beispiel:</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="search-suggestion" data-query="DSA">DSA</button>
          <button type="button" class="search-suggestion" data-query="Correctiv">Correctiv</button>
          <button type="button" class="search-suggestion" data-query="NetzDG">NetzDG</button>
          <button type="button" class="search-suggestion" data-query="Atlantic Council">Atlantic Council</button>
          <button type="button" class="search-suggestion" data-query="USAID">USAID</button>
          <button type="button" class="search-suggestion" data-query="Nordstream">Nordstream</button>
          <button type="button" class="search-suggestion" data-query="Faktenchecker">Faktenchecker</button>
        </div>
      </div>
    </div>

    <footer class="border-t border-line px-4 py-2 flex items-center justify-between text-xs text-muted">
      <span><kbd class="px-1.5 py-0.5 border border-line rounded text-[0.7rem]">↑</kbd> <kbd class="px-1.5 py-0.5 border border-line rounded text-[0.7rem]">↓</kbd> navigieren · <kbd class="px-1.5 py-0.5 border border-line rounded text-[0.7rem]">⏎</kbd> öffnen</span>
      <span class="hidden sm:inline" data-count></span>
    </footer>
  </form>
</dialog>

<style>
  #search-results .search-result {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 0.25rem;
    text-decoration: none;
    color: inherit;
    margin-bottom: 0.15rem;
  }
  #search-results .search-result:hover,
  #search-results .search-result.is-active {
    background: var(--color-paper-soft);
  }
  #search-results .search-result .badge {
    display: inline-block;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  #search-results .search-result .meta {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }
  #search-results mark {
    background: var(--color-accent-soft);
    color: var(--color-ink);
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .search-suggestion {
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    background: var(--color-paper-soft);
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: border-color 100ms, color 100ms;
  }
  .search-suggestion:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  type Entry = {
    type: string;
    title: string;
    snippet: string;
    url: string;
    meta?: string;
    tags?: string[];
    date?: string;
  };

  const typeLabels: Record<string, string> = {
    akteur: 'Akteur',
    faktencheck: 'Faktencheck',
    medien: 'Medien',
    recherche: 'Recherche',
    chronik: 'Chronik',
    glossar: 'Glossar',
    kapitel: 'Buch',
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results') as HTMLElement | null;
  const emptyPrompt = results?.querySelector<HTMLElement>('[data-empty-prompt]');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-close]');
  const form = document.getElementById('search-form') as HTMLFormElement | null;

  let entries: Entry[] | null = null;
  let activeIdx = -1;

  if (!dialog || !input || !results || !form) {
    // page loaded without the overlay — exit
  } else {
    async function ensureIndex() {
      if (entries) return;
      const res = await fetch('/search-index.json');
      entries = (await res.json()) as Entry[];
    }

    function escapeHtml(s: string) {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function highlight(text: string, tokens: string[]) {
      let out = escapeHtml(text);
      for (const t of tokens) {
        if (!t) continue;
        const re = new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        out = out.replace(re, '<mark>$1</mark>');
      }
      return out;
    }

    function score(entry: Entry, tokens: string[]) {
      let s = 0;
      const titleLow = entry.title.toLowerCase();
      const snipLow = entry.snippet.toLowerCase();
      const tagsLow = (entry.tags ?? []).join(' ').toLowerCase();
      for (const t of tokens) {
        if (!t) continue;
        if (titleLow.includes(t)) s += 5;
        if (snipLow.includes(t)) s += 2;
        if (tagsLow.includes(t)) s += 3;
        // prefix match in title gets bonus
        if (titleLow.startsWith(t)) s += 3;
      }
      return s;
    }

    function snippetFor(entry: Entry, tokens: string[]) {
      // Try to anchor snippet around first match
      const text = entry.snippet;
      const lower = text.toLowerCase();
      let pos = -1;
      for (const t of tokens) {
        if (!t) continue;
        const p = lower.indexOf(t);
        if (p !== -1 && (pos === -1 || p < pos)) pos = p;
      }
      let excerpt = text;
      const MAX = 180;
      if (pos !== -1 && text.length > MAX) {
        const start = Math.max(0, pos - 50);
        excerpt = (start > 0 ? '… ' : '') + text.slice(start, start + MAX);
        if (start + MAX < text.length) excerpt += ' …';
      } else if (text.length > MAX) {
        excerpt = text.slice(0, MAX) + ' …';
      }
      return excerpt;
    }

    function render(query: string) {
      const q = query.trim().toLowerCase();
      if (!q) {
        if (emptyPrompt) emptyPrompt.style.display = '';
        results!.querySelectorAll('.search-result').forEach((el) => el.remove());
        if (countEl) countEl.textContent = '';
        activeIdx = -1;
        return;
      }
      if (emptyPrompt) emptyPrompt.style.display = 'none';
      const tokens = q.split(/\s+/).filter(Boolean);

      const scored = (entries ?? [])
        .map((e) => ({ e, s: score(e, tokens) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 20);

      results!.querySelectorAll('.search-result').forEach((el) => el.remove());

      if (scored.length === 0) {
        const noHit = document.createElement('div');
        noHit.className = 'p-4 text-sm text-ink-soft';
        noHit.innerHTML = `Keine Treffer für <strong>${escapeHtml(query)}</strong>.`;
        results!.appendChild(noHit);
        if (countEl) countEl.textContent = '0 Treffer';
        activeIdx = -1;
        return;
      }

      const frag = document.createDocumentFragment();
      for (const { e } of scored) {
        const a = document.createElement('a');
        a.href = e.url;
        a.className = 'search-result';
        a.setAttribute('role', 'option');
        a.innerHTML = `
          <div class="leading-snug">
            <span class="badge">${typeLabels[e.type] ?? e.type}</span>
            <span class="font-serif">${highlight(e.title, tokens)}</span>
          </div>
          ${e.meta ? `<div class="meta">${escapeHtml(e.meta)}</div>` : ''}
          <div class="meta text-ink-soft mt-1">${highlight(snippetFor(e, tokens), tokens)}</div>
        `;
        frag.appendChild(a);
      }
      results!.appendChild(frag);
      if (countEl) countEl.textContent = `${scored.length} Treffer`;
      activeIdx = -1;
    }

    function setActive(idx: number) {
      const items = results!.querySelectorAll<HTMLElement>('.search-result');
      if (!items.length) return;
      activeIdx = ((idx % items.length) + items.length) % items.length;
      items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
      items[activeIdx].scrollIntoView({ block: 'nearest' });
    }

    async function open() {
      await ensureIndex();
      if (dialog!.open) return;
      dialog!.showModal();
      input!.value = '';
      render('');
      requestAnimationFrame(() => input!.focus());
    }

    function close() {
      if (!dialog!.open) return;
      dialog!.close();
    }

    // Public API: openSearch() / closeSearch()
    (window as any).openSearch = open;
    (window as any).closeSearch = close;

    // Trigger buttons
    document.querySelectorAll('[data-open-search]').forEach((btn) => {
      btn.addEventListener('click', () => open());
    });

    closeBtn?.addEventListener('click', close);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const items = results!.querySelectorAll<HTMLAnchorElement>('.search-result');
      if (activeIdx >= 0 && items[activeIdx]) {
        items[activeIdx].click();
      } else if (items[0]) {
        items[0].click();
      }
    });

    input.addEventListener('input', () => render(input!.value));

    results.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.search-result');
      if (link) close();
    });

    // Suggestion chips
    document.querySelectorAll<HTMLButtonElement>('.search-suggestion').forEach((btn) => {
      btn.addEventListener('click', () => {
        input!.value = btn.dataset.query ?? '';
        render(input!.value);
        input!.focus();
      });
    });

    // Keyboard
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIdx - 1);
      }
    });

    // Global shortcut: Cmd/Ctrl-K and "/"
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const isInput = (e.target as HTMLElement)?.matches?.('input, textarea, [contenteditable="true"]');
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      } else if (e.key === '/' && !isInput && !dialog!.open) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
