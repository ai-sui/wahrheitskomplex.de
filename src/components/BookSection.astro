---
import type { Book } from '../data/book';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<section class="container-page py-16 md:py-20">
  <div class="grid md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-start border-t border-line pt-12">
    <!-- Cover-Platzhalter (SVG, kein Asset nötig) -->
    <a
      href={book.buyUrl}
      rel="noopener"
      class="block w-44 md:w-52 shrink-0 mx-auto md:mx-0 group"
    >
      <svg
        viewBox="0 0 200 280"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto rounded-sm shadow-[0_18px_36px_-12px_rgba(0,0,0,0.45),0_6px_12px_-4px_rgba(0,0,0,0.25)] transition-transform group-hover:-translate-y-1"
        role="img"
        aria-labelledby="book-cover-title"
      >
        <title id="book-cover-title">{`Buchcover: ${book.title} — Westend Verlag`}</title>

        <!-- Schwarzer Hintergrund -->
        <rect width="200" height="280" fill="#000" />

        <!-- Rotes Trapez hinter dem X von KOMPLEX -->
        <polygon points="142,108 200,108 200,138 152,138" fill="#ed3826" />

        <!-- Großes rotes Pfeil-Trapez Mitte-Bottom -->
        <polygon points="0,178 142,178 162,205 0,205" fill="#ed3826" />

        <!-- Autor: NORBERT HÄRING (gray, condensed bold) -->
        <g font-family="'Helvetica Neue Condensed','Arial Narrow',Impact,sans-serif" font-weight="900" fill="#9a958c">
          <text x="14" y="38" font-size="22" textLength="68" lengthAdjust="spacingAndGlyphs">NORBERT</text>
          <text x="14" y="60" font-size="22" textLength="58" lengthAdjust="spacingAndGlyphs">HÄRING</text>
        </g>

        <!-- Titel: DER / WAHRHEITS / KOMPLEX (white, condensed bold) -->
        <g font-family="'Helvetica Neue Condensed','Arial Narrow',Impact,sans-serif" font-weight="900" fill="#fff">
          <text x="92" y="60" font-size="30" textLength="44" lengthAdjust="spacingAndGlyphs">DER</text>
          <text x="14" y="98" font-size="30" textLength="172" lengthAdjust="spacingAndGlyphs">WAHRHEITS</text>
          <text x="14" y="138" font-size="30" textLength="172" lengthAdjust="spacingAndGlyphs">KOMPLEX</text>
        </g>

        <!-- Untertitel auf schwarzem Grund -->
        <g font-family="'Helvetica Neue','Arial',sans-serif" font-weight="700" fill="#fff" font-size="9">
          <text x="14" y="232">Wie NGOs im Staats­auftrag</text>
          <text x="14" y="245">unerwünschte</text>
          <text x="14" y="258">Meinungen bekämpfen</text>
        </g>

        <!-- Verlag bottom-right -->
        <text x="186" y="200" text-anchor="end" font-family="'Helvetica Neue','Arial',sans-serif" font-weight="700" fill="#fff" font-size="7" letter-spacing="0.5">WESTEND</text>
      </svg>
      <p class="mt-3 text-center text-xs text-muted">Cover-Vorschau · Schutzumschlag</p>
    </a>

    <div>
      <p class="meta-label text-accent mb-3">Das Buch</p>
      <h2 class="font-serif text-3xl md:text-4xl leading-tight mb-2">
        {book.title}
      </h2>
      <p class="font-serif italic text-lg md:text-xl text-ink-soft mb-5 leading-snug max-w-xl">
        {book.subtitle}
      </p>

      <p class="text-ink-soft leading-relaxed mb-6 max-w-xl">{book.blurb}</p>

      <dl class="grid grid-cols-[max-content_1fr] gap-x-5 gap-y-2 text-sm border-y border-line py-4 mb-6 max-w-md">
        <dt class="meta-label">Autor</dt>
        <dd>{book.author}</dd>
        <dt class="meta-label">Verlag</dt>
        <dd>{book.publisher}</dd>
        <dt class="meta-label">Erschienen</dt>
        <dd>{book.publicationDate.replace(/^Erschienen\s+/, '')}</dd>
      </dl>

      <p class="text-sm text-ink-soft leading-relaxed mb-6 max-w-xl">
        <span class="meta-label text-muted block mb-1.5">Über den Autor</span>
        {book.authorBio}
      </p>

      {book.buyUrl && (
        <a
          href={book.buyUrl}
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border border-ink px-5 py-2.5 text-sm font-medium no-underline hover:bg-ink hover:text-paper transition-colors"
        >
          Beim Westend Verlag <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</section>
