---
import { withBase } from '../utils/url';

interface Props {
  name: string;
  slug: string;
  kategorie: string;
  akteurstyp: string;
  land: string;
  themen: string[];
  kurzbeschreibung: string;
  fulltext: boolean;
  haeringLink?: string;
}

const {
  name,
  slug,
  kategorie,
  akteurstyp,
  land,
  themen,
  kurzbeschreibung,
  fulltext,
  haeringLink,
} = Astro.props;

const themenAttr = themen.join('|');

// Logik für Titel-Link und CTA:
//   fulltext=true                  → eigenes Profil unter /portraits/{slug}
//   fulltext=false + haeringLink   → externer Link zu Härings Tiefenartikel
//   fulltext=false ohne Link       → ohne Verlinkung („Profil folgt")
const detailHref = fulltext ? `/portraits/${slug}` : haeringLink;
const isExternal = !fulltext && Boolean(haeringLink);
---

<article
  class="group flex flex-col bg-paper-soft border border-line rounded-sm p-6 transition-colors hover:border-accent"
  data-actor-card
  data-akteurstyp={akteurstyp}
  data-themen={themenAttr}
>
  {/*
    Dachzeile (kategorie) ist auf Norberts Hinweis vom 20.5.2026 entfernt:
    "Die Dachzeilen finde ich entbehrlich. Dachzeilen und andere
    Zusatzebenen finde ich nur sinnvoll, wo ein einzelner Artikel /
    Textobjekt präsentiert wird. Wo verschiedene Objekte gleichzeitig
    präsentiert werden, erschweren zusätzliche Ebenen die Übersicht."
    Die Land-Angabe oben rechts bleibt als kompakte Verortung.
  */}
  <div class="flex items-baseline justify-end gap-3 mb-3">
    <p class="text-xs text-muted">{land}</p>
  </div>

  <h3 class="font-serif text-xl md:text-2xl leading-snug mb-3">
    {detailHref ? (
      <a
        href={detailHref}
        rel={isExternal ? 'noopener' : undefined}
        class="no-underline"
      >
        {name}
      </a>
    ) : (
      <span>{name}</span>
    )}
  </h3>

  <p class="text-sm text-ink-soft leading-relaxed mb-5 flex-1">{kurzbeschreibung}</p>

  <div class="flex flex-wrap gap-1.5 mb-4">
    {themen.map((thema) => (
      <span class="text-[0.65rem] uppercase tracking-wider px-2 py-0.5 bg-paper border border-line rounded-full text-muted">
        {thema}
      </span>
    ))}
  </div>

  <p class="meta-label text-muted border-t border-line pt-3 mt-auto">
    {fulltext ? (
      <a href={withBase(`/portraits/${slug}`)} class="text-accent no-underline hover:underline">
        Profil ansehen →
      </a>
    ) : haeringLink ? (
      <a
        href={haeringLink}
        rel="noopener" target="_blank"
        class="text-accent no-underline hover:underline"
      >
        Profil auf norberthaering.de ↗
      </a>
    ) : (
      <span>Profil folgt</span>
    )}
  </p>
</article>
