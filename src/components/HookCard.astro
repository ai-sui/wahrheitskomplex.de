---
import type { HookCard } from '../data/homepage';

interface Props {
  card: HookCard;
}

const { card } = Astro.props;
---

<a
  href={card.href}
  class="group flex flex-col bg-paper-soft border border-line rounded-sm p-6 md:p-7 no-underline hover:border-accent transition-colors"
>
  <p class="meta-label text-accent mb-4">{card.tag}</p>

  <p class="font-serif text-2xl md:text-3xl font-semibold leading-tight mb-3 group-hover:text-accent transition-colors">
    {card.punch}
  </p>

  <p class="text-sm text-ink-soft leading-relaxed mb-6 flex-1">
    <span class="text-muted">…</span>{card.text}
  </p>

  <dl class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted border-t border-line pt-4 mt-auto">
    <div class="flex items-center gap-1.5">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-verified" aria-hidden="true"></span>
      <dt class="sr-only">Verifiziert:</dt>
      <dd>{card.verified}</dd>
    </div>
    <div>
      <dt class="sr-only">Lesedauer:</dt>
      <dd>{card.readingTime}</dd>
    </div>
  </dl>
</a>
