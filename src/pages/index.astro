---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookSection from '../components/BookSection.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Carousel from '../components/Carousel.astro';
import UnifiedNewsCard from '../components/UnifiedNewsCard.astro';
import FaktencheckCard from '../components/FaktencheckCard.astro';
import ActorPortraitCard from '../components/ActorPortraitCard.astro';
import SpinnenImNetzCard from '../components/SpinnenImNetzCard.astro';
import TimelineEvent from '../components/TimelineEvent.astro';
import SiteIntro from '../components/SiteIntro.astro';
import DefinitionsTeaser from '../components/DefinitionsTeaser.astro';
import AlleFaktenchecksCard from '../components/AlleFaktenchecksCard.astro';
import { book } from '../data/book';
import { chronik } from '../data/chronik';
import { withBase } from '../utils/url';

// --- Daten fürs „Neues aus dem Wahrheitskomplex"-Karussell ---
// Mische Medien (Videos/Interviews/Rezensionen), Faktenchecks und
// ausgewählte Chronik-Einträge mit Häring-Link.
const medien = await getCollection('medien');
const faktenchecks = await getCollection('faktenchecks');

// --- Daten fürs Akteurs-Karussell ---
const actors = (await getCollection('actors'))
  .filter((a) => a.data.fulltext)
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

type FeedItem = {
  date: string;
  badge: string;
  title: string;
  source: string;
  url: string;
  thumb?: string;
  paywall?: boolean;
};

const typeLabels: Record<string, string> = {
  video: 'Video',
  podcast: 'Podcast',
  interview: 'Interview',
  rezension: 'Rezension',
  vortrag: 'Vortrag',
};

const newsFeed: FeedItem[] = [
  ...medien.map((m) => ({
    date: m.data.date,
    badge: typeLabels[m.data.type] ?? 'Beitrag',
    title: m.data.title,
    source: m.data.outlet,
    url: m.data.url,
    thumb: m.data.youtubeId
      ? withBase(`/yt-thumbs/${m.data.youtubeId}.jpg`)
      : withBase(`/article-thumbs/${m.id}.jpg`),
    paywall: m.data.paywall,
  })),
  ...faktenchecks.map((fc) => ({
    date: fc.data.date,
    badge: 'Faktencheck',
    title: fc.data.title,
    // Im "Neues"-Karussell soll die Quelle der Tiefenartikel sein
    // (norberthaering.de), nicht der kritisierte Faktenchecker.
    source: 'norberthaering.de',
    url: fc.data.url,
    thumb: fc.data.thumbOverride
      ? withBase(fc.data.thumbOverride)
      : withBase(`/faktencheck-thumbs/${fc.id}.jpg`),
  })),
  // Chronik-Einträge gehen NICHT mehr ins "Neues"-Karussell — sie haben
  // ihren eigenen Block "Was seither geschah" weiter unten. So bleibt
  // jede Sektion thematisch eindeutig.
];

const recentNews = newsFeed
  .sort((a, b) => {
    const pad = (d: string) =>
      d.split('-').length === 3 ? d : d.split('-').length === 2 ? `${d}-15` : `${d}-12-31`;
    return pad(b.date).localeCompare(pad(a.date));
  })
  .slice(0, 10);

// --- Faktenchecks-Karussell ---
// `order` (falls gesetzt) übersteuert das echte Datum für Sortierzwecke.
const sortKey = (fc: { data: { date: string; order?: string } }) =>
  fc.data.order ?? fc.data.date;
const recentFaktenchecks = [...faktenchecks]
  .sort((a, b) => new Date(sortKey(b)).getTime() - new Date(sortKey(a)).getTime())
  .slice(0, 10);

// --- Chronik-Block „Was seither geschah" ---
const recentChronik = [...chronik]
  .sort((a, b) => {
    const pad = (d: string) =>
      d.split('-').length === 3 ? d : d.split('-').length === 2 ? `${d}-31` : `${d}-12-31`;
    return pad(b.date).localeCompare(pad(a.date));
  })
  .slice(0, 5);

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  alternateName: book.subtitle,
  author: { '@type': 'Person', name: book.author, url: 'https://norberthaering.de' },
  publisher: { '@type': 'Organization', name: book.publisher, url: book.buyUrl },
  datePublished: '2026-05',
  inLanguage: 'de',
  description: book.blurb,
};
---

<BaseLayout
  title="Wahrheitskomplex — Begleitseite zum Buch von Norbert Häring"
  jsonLd={bookSchema}
>
  <!-- Begleitseiten-Erklärung oben -->
  <SiteIntro />

  <!-- Reinzieher: Drei zufällige Definitionen aus dem Wahrheitskomplex-Vokabular -->
  <DefinitionsTeaser />

  <!-- Karussell 1: Neues aus dem Wahrheitskomplex (Mix) — der eigentliche Einstieg -->
  <section class="container-page pt-6 md:pt-10 pb-10 md:pb-16">
    <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-line">
      <h2 class="font-serif text-2xl md:text-3xl leading-tight">
        Neues aus dem Wahrheitskomplex.
      </h2>
      <a
        href={withBase('/im-gespraech')}
        class="hidden sm:inline-block text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent shrink-0"
      >
        Alle Beiträge →
      </a>
    </div>

    <Carousel label="Aktuelle Beiträge aus dem Wahrheitskomplex">
      {recentNews.map((item) => (
        <UnifiedNewsCard
          badge={item.badge}
          title={item.title}
          source={item.source}
          date={item.date}
          url={item.url}
          thumb={item.thumb}
          paywall={item.paywall}
        />
      ))}
    </Carousel>
  </section>

  <!-- Karussell 2: NGOs des Wahrheitskomplexes -->
  <section class="container-page py-10 md:py-16 border-t border-line">
    <div class="flex items-baseline justify-between mb-6 pb-4 border-b border-line gap-4">
      <h2 class="font-serif text-2xl md:text-3xl leading-tight min-w-0">
        {actors.length} wichtige NGOs des Wahrheitskomplexes.
      </h2>
      <a
        href={withBase('/portraits')}
        class="hidden sm:inline-block text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent shrink-0 self-end"
      >
        Zu den Porträts →
      </a>
    </div>

    <Carousel label="Wichtige NGOs des Wahrheitskomplexes">
      {actors.map((a) => (
        <ActorPortraitCard
          name={a.data.name}
          slug={a.id}
          akteurstyp={a.data.akteurstyp}
          land={a.data.land}
          gegruendet={a.data.gegruendet}
          kurzbeschreibung={a.data.kurzbeschreibung}
          kernkritik={a.data.kernkritik}
          haeringLink={a.data.haeringLink}
        />
      ))}
      <SpinnenImNetzCard />
    </Carousel>
  </section>

  <!-- Chronik-Block „Was seither geschah" -->
  <section class="container-page py-10 md:py-16 border-t border-line">
    <div class="mb-8 pb-4 border-b border-line">
      <h2 class="font-serif text-2xl md:text-3xl leading-tight">Was seither geschah.</h2>
    </div>

    <div class="max-w-4xl">
      {recentChronik.map((e) => <TimelineEvent eintrag={e} compact />)}

      <p class="text-right mt-2">
        <a
          href={withBase('/chronik')}
          class="text-sm text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          Vollständige Chronik →
        </a>
      </p>
    </div>
  </section>

  <!-- Karussell 3: Faktenchecker-Check -->
  <section class="container-page py-10 md:py-16 border-t border-line">
    <div class="mb-6 pb-4 border-b border-line">
      <h2 class="font-serif text-2xl md:text-3xl leading-tight">Faktenchecker-Check.</h2>
    </div>

    <Carousel label="Faktenchecker-Check">
      {recentFaktenchecks.map((fc) => (
        <FaktencheckCard
          title={fc.data.title}
          faktenchecker={fc.data.faktenchecker}
          actorSlug={fc.data.actorSlug}
          slug={fc.id}
          date={fc.data.date}
          themen={fc.data.themen}
          behauptung={fc.data.behauptung}
          urteil={fc.data.urteil}
          realitaet={fc.data.realitaet}
          summary={fc.data.summary}
          thumbOverride={fc.data.thumbOverride}
          url={fc.data.url}
        />
      ))}
      <AlleFaktenchecksCard count={faktenchecks.length} />
    </Carousel>
  </section>

  <!-- Das Buch (am Ende, weil das Cover oben in SiteIntro schon vorkommt) -->
  <BookSection book={book} />

  <NewsletterForm />
</BaseLayout>
