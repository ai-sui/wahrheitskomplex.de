---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { glossar } from '../../data/glossar';
import { definitionen } from '../../data/definitionen';
import { withBase } from '../../utils/url';
import { breadcrumbList } from '../../utils/seo';

const sorted = [...glossar].sort((a, b) =>
  a.term.localeCompare(b.term, 'de'),
);

// Definitionen mit Volltext bekommen oben einen eigenen Block
// als Wegweiser zu den Detail-Seiten /glossar/[slug].
const tiefencheck = definitionen
  .filter((d) => d.slug && d.volltext && d.volltext.length > 0)
  .sort((a, b) => a.term.localeCompare(b.term, 'de'));

const bc = breadcrumbList(Astro.site, [{ name: 'Glossar', path: '/glossar' }]);
---

<BaseLayout
  title="Glossar"
  description="Kurzdefinitionen zu wiederkehrenden Begriffen: DSA, NetzDG, IFCN, SMC, Five Eyes, USAID, EDMO und mehr."
  jsonLd={bc}
>
  <section class="container-page py-12 md:py-16 max-w-3xl">
    <p class="meta-label text-accent mb-3">Glossar</p>
    <h1 class="font-serif text-3xl md:text-4xl leading-tight mb-4">
      Begriffe, die hier vorkommen.
    </h1>
    <p class="text-ink-soft text-lg leading-relaxed mb-10">
      Kurz, sachlich, mit Querverweisen ins Atlas-Profil, wo der Begriff zur Sache wird.
    </p>

    {tiefencheck.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl md:text-3xl leading-tight mb-2">
          Begriffe im Tiefencheck.
        </h2>
        <p class="text-ink-soft leading-relaxed mb-6">
          Wo offizielle Sprachverwendungen einen genaueren Blick verdienen — mit
          Quellen, Entstehungsgeschichte und Buchverweisen.
        </p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {tiefencheck.map((d) => (
            <li>
              <a
                href={withBase(`/glossar/${d.slug}`)}
                class="block bg-paper-soft border border-line border-l-4 border-l-accent rounded-sm p-4 md:p-5 no-underline transition-colors hover:border-accent"
              >
                <p class="meta-label text-muted mb-1">Was ist …?</p>
                <p class="font-serif text-lg md:text-xl leading-tight">
                  {d.term}<span class="text-accent">?</span>
                </p>
                <p class="text-sm text-ink-soft leading-snug mt-2 line-clamp-3">
                  {d.antwort}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2 class="font-serif text-2xl md:text-3xl leading-tight mb-2">
      Abkürzungen und Fachbegriffe.
    </h2>

    <dl class="border-t border-line mt-6">
      {sorted.map((entry) => (
        <div
          id={entry.term.toLowerCase().replace(/\s+/g, '-')}
          class="border-b border-line py-6 grid sm:grid-cols-[10rem_1fr] gap-4 sm:gap-8 scroll-mt-32"
        >
          <dt>
            <p class="font-serif text-xl font-semibold">{entry.term}</p>
            {entry.longForm && (
              <p class="text-sm text-muted leading-snug mt-1">{entry.longForm}</p>
            )}
          </dt>
          <dd>
            <p class="text-ink-soft leading-relaxed">{entry.definition}</p>
            {entry.siehe && entry.siehe.length > 0 && (
              <p class="mt-3 text-sm flex flex-wrap gap-x-4 gap-y-1">
                <span class="meta-label text-muted">Siehe:</span>
                {entry.siehe.map((ref) => (
                  <a
                    href={withBase(ref.href)}
                    class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
                  >
                    {ref.label}
                  </a>
                ))}
              </p>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>
