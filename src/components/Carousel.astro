---
// Horizontales Karussell mit Scroll-Snap, prev/next-Buttons und Touch-Swipe.
// Cards werden als <slot/> übergeben — Width pro Card via CSS-Custom-Properties.
interface Props {
  label: string; // ARIA-Label für die Region
  cardClass?: string; // optional zusätzliche Card-Klassen
}

const { label, cardClass = '' } = Astro.props;
---

<section class="carousel-root relative" data-carousel aria-label={label}>
  <div
    class="carousel-track flex gap-4 md:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mb-4 px-1 -mx-1"
    data-track
    role="region"
    tabindex="0"
  >
    <slot />
  </div>

  <button
    type="button"
    class="carousel-btn carousel-prev"
    data-prev
    aria-label="Vorheriger Beitrag"
    hidden
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M15 6 9 12l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button
    type="button"
    class="carousel-btn carousel-next"
    data-next
    aria-label="Nächster Beitrag"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<style is:global>
  .carousel-track::-webkit-scrollbar { height: 6px; }
  .carousel-track::-webkit-scrollbar-track { background: transparent; }
  .carousel-track::-webkit-scrollbar-thumb { background: var(--color-line); border-radius: 3px; }

  .carousel-track > * {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: min(88vw, 22rem);
  }
  @media (min-width: 768px) {
    .carousel-track > * { width: min(50%, 24rem); }
  }
  @media (min-width: 1024px) {
    .carousel-track > * { width: min(33.333%, 24rem); }
  }

  .carousel-btn {
    position: absolute;
    top: 32%;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 16px -8px rgba(26,26,26,0.25);
    transition: background-color 120ms ease, color 120ms ease, opacity 200ms ease;
    z-index: 2;
  }
  /* Pfeile nur auf Pointer-fähigen Geräten — Touch hat Swipe */
  @media (hover: hover) and (pointer: fine) {
    .carousel-btn { display: flex; }
  }
  .carousel-btn:hover { background: var(--color-ink); color: var(--color-paper); }
  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .carousel-btn[hidden] { display: none; }
  .carousel-prev { left: -1.25rem; }
  .carousel-next { right: -1.25rem; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !prev || !next) continue;

    function step() {
      const first = track!.firstElementChild as HTMLElement | null;
      if (!first) return 320;
      const styles = getComputedStyle(track!);
      const gap = parseFloat(styles.columnGap || styles.gap || '20');
      return first.offsetWidth + gap;
    }

    function update() {
      const max = track!.scrollWidth - track!.clientWidth;
      const x = track!.scrollLeft;
      prev!.hidden = x <= 2;
      next!.hidden = x >= max - 2;
    }

    prev.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Keyboard support
    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        track.scrollBy({ left: step(), behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      }
    });
  }
</script>
