---
import { withBase } from '../utils/url';

interface Props {
  name: string;
  slug: string;
  akteurstyp: string;
  land: string;
  gegruendet?: string | number;
  kurzbeschreibung: string;
  haeringLink?: string;
}

const { name, slug, akteurstyp, land, gegruendet, kurzbeschreibung, haeringLink } =
  Astro.props;

const metaLine = [akteurstyp, land, gegruendet]
  .filter((s) => s !== undefined && s !== '')
  .join(' · ');

// Primärziel ist Norberts ausführliches Porträt auf norberthaering.de.
// Falls keines hinterlegt ist, fällt die Karte auf das interne Profil zurück.
const hasExternal = Boolean(haeringLink);
const targetHref = hasExternal ? (haeringLink as string) : withBase(`/portraits/${slug}`);
const ctaLabel = hasExternal
  ? 'Vollständiges Porträt bei norberthaering.de →'
  : 'Profil ansehen →';
---

{/*
  Auf Ralphs Hinweis vom 24.5.2026 ("Karussell ist etwas zu hoch, viel
  leerer Raum") zeigt diese Karte nur noch die kurzbeschreibung. Die
  kernkritik fiel raus, weil sie zwischen den Akteuren stark unterschiedlich
  lang ist und so den Höhen-Sync des Karussells in die Höhe trieb. Die
  vollständige Kernkritik bleibt natürlich auf der Detail-Seite und im
  Porträt auf norberthaering.de erhalten.
*/}
<a
  href={targetHref}
  rel={hasExternal ? 'noopener' : undefined}
  class="group h-full flex flex-col bg-paper-soft border border-line border-l-4 border-l-accent rounded-sm p-6 md:p-7 no-underline transition-colors hover:border-accent"
>
  <p class="meta-label text-muted mb-4 leading-tight">{metaLine}</p>

  <h3 class="font-serif text-xl md:text-2xl leading-tight mb-4">
    {name}
  </h3>

  <p class="text-sm text-ink-soft leading-relaxed flex-1 mb-5">
    {kurzbeschreibung}
  </p>

  <p class="text-sm text-accent font-medium border-t border-line pt-4 mt-auto">
    {ctaLabel}
  </p>
</a>
