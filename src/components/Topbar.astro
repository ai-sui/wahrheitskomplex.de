---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Start' },
  { href: '/atlas', label: 'Atlas' },
  { href: '/recherchen', label: 'Recherchen' },
  { href: '/ueber', label: 'Über' },
];
---

<div class="bg-ink text-paper text-xs">
  <div class="container-page py-2 flex items-center justify-center gap-2 text-center">
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    <span class="opacity-90">
      Demo-Ausgabe — Inhalte vorläufig, nicht zur Zitation. Buch erscheint 2026.
    </span>
  </div>
</div>

<header class="border-b border-line bg-paper/80 backdrop-blur-sm sticky top-0 z-30">
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" class="flex items-baseline gap-2 no-underline">
      <span class="font-serif text-xl font-semibold tracking-tight">Wahrheits<span class="text-accent">komplex</span></span>
      <span class="meta-label hidden sm:inline">Recherche-Atlas</span>
    </a>

    <nav class="flex items-center gap-4 sm:gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm no-underline transition-colors',
            isActive(link.href) ? 'text-accent font-semibold' : 'text-ink-soft hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
