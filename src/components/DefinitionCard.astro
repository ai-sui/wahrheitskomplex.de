---
import type { Definition } from '../data/definitionen';
import { withBase } from '../utils/url';

interface Props {
  d: Definition;
}

const { d } = Astro.props;

const hasDeepProfile = Boolean(d.slug && d.volltext && d.volltext.length > 0);
---

<article
  class="bg-paper-soft border border-line rounded-sm p-6 md:p-7 flex flex-col h-full"
  data-definition
>
  <p class="meta-label text-accent mb-3 flex items-center gap-2">
    <span aria-hidden="true" class="font-serif text-2xl text-accent leading-none -mt-1">?</span>
    Was ist …
  </p>

  <h3 class="font-serif text-2xl md:text-3xl leading-tight mb-4">
    {d.term}<span class="text-accent">?</span>
  </h3>

  <p class="text-sm md:text-base text-ink-soft leading-relaxed mb-5 flex-1">
    {d.antwort}
    {hasDeepProfile && (
      <>
        {' '}
        <a
          href={withBase(`/glossar/${d.slug}`)}
          class="text-accent font-medium underline decoration-accent/40 underline-offset-4 hover:decoration-accent whitespace-nowrap"
        >
          Mehr →
        </a>
      </>
    )}
  </p>

  <div class="border-t border-line pt-3 mt-auto text-xs text-muted leading-snug">
    <p><span class="meta-label text-muted">Quelle:</span> {d.quelle}</p>
    {d.link && (
      <p class="mt-1.5">
        <a
          href={withBase(d.link.href)}
          class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {d.link.label} →
        </a>
      </p>
    )}
  </div>
</article>
