---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Begleitseite zum Buch „Der Wahrheitskomplex" von Norbert Häring (Westend Verlag, 2026). Porträts der Akteure (Faktenchecker, Stiftungen, NGOs, Think Tanks), dokumentierte Faktencheck-Fehlgriffe, laufende Chronik — recherchiert und mit Quellen belegt.',
  ogImage = '/og.png',
  jsonLd,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://wahrheitskomplex.de');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wahrheitskomplex',
  alternateName: 'Porträts und Recherchen zum Buch „Der Wahrheitskomplex"',
  url: Astro.site?.toString() ?? 'https://wahrheitskomplex.de/',
  description,
  inLanguage: 'de-DE',
  publisher: {
    '@type': 'Person',
    name: 'Norbert Häring',
    url: 'https://norberthaering.de',
  },
};

// "Wahrheitskomplex" anhaengen, ausser es ist schon im Title (verhindert Doppel-Branding)
const fullTitle = /wahrheitskomplex/i.test(title) ? title : `${title} — Wahrheitskomplex`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wahrheitskomplex.de');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImageUrl.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Wahrheitskomplex" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl.toString()} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <JsonLd data={websiteSchema} />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body class="min-h-dvh flex flex-col">
    <Topbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
  </body>
</html>
