---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum" description="Impressum der Demo-Site Wahrheitskomplex.">
  <section class="container-page py-16 max-w-2xl">
    <p class="meta-label text-accent mb-3">Rechtliches</p>
    <h1 class="font-serif text-4xl md:text-5xl mb-6">Impressum</h1>

    <p class="text-ink-soft leading-relaxed mb-4">
      Diese Seite ist eine <strong>Demo-Ausgabe</strong> zum Buch <em>Der Wahrheitskomplex</em>
      von Norbert Häring (Westend Verlag, 2026). Sie befindet sich im Aufbau und ist nicht
      zur dauerhaften Veröffentlichung bestimmt.
    </p>

    <p class="text-ink-soft leading-relaxed mb-4">
      Ein vollständiges Impressum mit Anbieterkennzeichnung nach &sect; 5 TMG folgt vor dem offiziellen Launch.
      Bis dahin Anfragen bitte an den Westend Verlag oder an Norbert Häring direkt.
    </p>

    <p class="mt-8">
      <a href="https://norberthaering.de" rel="noopener" class="text-accent underline decoration-accent/40 hover:decoration-accent">
        norberthaering.de →
      </a>
    </p>
  </section>
</BaseLayout>
