---
import type { HookCard } from '../data/homepage';
import { withBase } from '../utils/url';

interface Props {
  card: HookCard;
}

const { card } = Astro.props;
const isExternal = card.href.startsWith('http');
---

<a
  href={withBase(card.href)}
  rel={isExternal ? 'noopener' : undefined}
  class="group flex flex-col h-full bg-paper-soft border border-line rounded-sm p-6 md:p-7 no-underline hover:border-accent transition-colors"
>
  <p class="meta-label text-accent mb-4">{card.tag}</p>

  <p class="font-serif text-2xl md:text-[1.7rem] font-semibold leading-tight mb-3">
    {card.punch}
  </p>

  <p class="text-sm text-ink-soft leading-relaxed mb-6 flex-1">
    <span class="text-muted">…</span>{card.text}
  </p>

  <p class="text-xs text-muted border-t border-line pt-4 mt-auto flex items-center gap-2">
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-verified shrink-0" aria-hidden="true"></span>
    <span>{card.meta}</span>
  </p>
</a>
