---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="404 — nicht gefunden" description="Diese Seite existiert nicht. Vielleicht ein Faktencheck-Artefakt.">
  <section class="container-page py-24 md:py-32 max-w-2xl">
    <p class="meta-label text-accent mb-3">Fehler 404</p>
    <h1 class="font-serif text-5xl md:text-6xl leading-tight mb-6">
      Diese Seite ist <em class="text-accent not-italic">nicht verfügbar</em>.
    </h1>
    <p class="text-lg text-ink-soft leading-relaxed mb-3">
      Möglicherweise wurde sie verschoben, möglicherweise hat sie nie existiert,
      möglicherweise war die Quelle, die hierher verlinkt hat, ungenau.
    </p>
    <p class="text-lg text-ink-soft leading-relaxed mb-10">
      Wir markieren das so, statt es schweigend umzuleiten.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href={withBase('/')}
        class="rounded-full bg-ink text-paper px-5 py-2.5 text-sm font-medium no-underline hover:bg-accent transition-colors"
      >
        Zur Startseite
      </a>
      <a
        href={withBase('/atlas')}
        class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors"
      >
        Zum Akteurs-Atlas
      </a>
    </div>
  </section>
</BaseLayout>
