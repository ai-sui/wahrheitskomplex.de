---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Start' },
  { href: '/atlas', label: 'Atlas' },
];
---

<header class="border-b border-line bg-paper/80 backdrop-blur-sm sticky top-0 z-30">
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" class="flex items-baseline gap-2 no-underline">
      <span class="font-serif text-xl font-semibold tracking-tight">Wahrheits<span class="text-accent">komplex</span></span>
      <span class="meta-label hidden sm:inline">Recherche-Atlas</span>
    </a>

    <nav class="flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm no-underline transition-colors',
            isActive(link.href) ? 'text-accent font-semibold' : 'text-ink-soft hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="#newsletter"
        class="hidden sm:inline-block rounded-full border border-ink bg-ink px-4 py-1.5 text-sm font-medium text-paper no-underline transition-colors hover:bg-accent hover:border-accent"
      >
        Newsletter
      </a>
    </nav>
  </div>
</header>
