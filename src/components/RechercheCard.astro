---
import type { Recherche } from '../data/recherchen';
import { withBase } from '../utils/url';

interface Props {
  recherche: Recherche;
}

const { recherche: r } = Astro.props;
---

<article id={r.slug} class="bg-paper-soft border border-line rounded-sm p-6 md:p-8 flex flex-col scroll-mt-32">
  <div class="flex items-baseline justify-between mb-3 gap-3">
    <p class="meta-label text-accent">{r.tag}</p>
    {r.buchKapitel && <p class="meta-label text-muted">{r.buchKapitel}</p>}
  </div>

  <h3 class="font-serif text-xl md:text-2xl leading-snug mb-6">
    {r.frage}
  </h3>

  <dl class="grid gap-5 text-sm border-t border-line pt-5 flex-1">
    <div>
      <dt class="meta-label text-muted mb-1.5">Was im Diskurs gesagt wird</dt>
      <dd class="text-ink-soft leading-relaxed">{r.mainstream}</dd>
    </div>
    <div>
      <dt class="meta-label text-accent mb-1.5">Was die Recherchen zeigen</dt>
      <dd class="text-ink leading-relaxed">{r.recherche}</dd>
    </div>
    <div>
      <dt class="meta-label text-muted mb-1.5">Quellenlage</dt>
      <dd class="text-ink-soft leading-relaxed text-xs">{r.quelle}</dd>
    </div>
  </dl>

  <div class="flex flex-wrap gap-3 border-t border-line pt-5 mt-6 text-sm">
    {r.atlasLink && (
      <a
        href={withBase(r.atlasLink)}
        class="text-accent font-medium underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        Im Porträt →
      </a>
    )}
    {r.haeringLink && (
      <a
        href={r.haeringLink}
        rel="noopener"
        class="text-ink-soft underline decoration-line hover:decoration-accent hover:text-accent"
      >
        Tiefenartikel →
      </a>
    )}
  </div>
</article>
