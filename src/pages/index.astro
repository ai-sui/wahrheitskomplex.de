---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Wahrheitskomplex">
  <section class="container-page py-16 md:py-24">
    <p class="meta-label mb-4">Demo · Phase 1</p>
    <h1>
      Der <em class="text-accent not-italic">Wahrheits&shy;komplex</em><br />
      &mdash; ein Atlas zum Buch.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
      Eine ruhige Recherche-Plattform zum gleichnamigen Buch von Norbert Häring. Dies ist Phase 1: Design-System steht.
      Hero, Hooks und Akteurs-Atlas folgen in den nächsten Schritten.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/atlas" class="rounded-full bg-ink text-paper px-5 py-2.5 text-sm font-medium no-underline hover:bg-accent transition-colors">
        Zum Akteurs-Atlas
      </a>
      <a href="https://norberthaering.de" rel="noopener" class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">
        norberthaering.de besuchen &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
