---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCard from '../components/MediaCard.astro';
import FilterChips from '../components/FilterChips.astro';

const medien = (await getCollection('medien')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const typeOptions = ['Video', 'Podcast', 'Interview', 'Rezension', 'Vortrag'];
const typeMap: Record<string, string> = {
  video: 'Video',
  podcast: 'Podcast',
  interview: 'Interview',
  rezension: 'Rezension',
  vortrag: 'Vortrag',
};
---

<BaseLayout
  title="Im Gespräch"
  description="Aktuelle Videos, Interviews, Rezensionen und Podcasts zu „Der Wahrheitskomplex“. Sortiert nach Erscheinungsdatum."
>
  <section class="container-page py-12 md:py-16">
    <p class="meta-label text-accent mb-3">Im Gespräch</p>
    <h1 class="font-serif text-3xl md:text-4xl leading-tight mb-4 max-w-3xl">
      Aktuelle Stimmen zum Wahrheitskomplex.
    </h1>
    <p class="max-w-2xl text-ink-soft text-lg leading-relaxed">
      Videos, Interviews und Rezensionen — sortiert nach Erscheinungsdatum,
      neueste oben. YouTube-Videos werden privacy-schonend eingebettet: erst
      ein Klick lädt das eigentliche Video, vorher fließen keine Daten an
      Drittanbieter.
    </p>

    <div class="mt-10 border-y border-line py-6">
      <FilterChips legend="Format" group="thema" options={typeOptions} />
    </div>

    <div class="mt-4 flex items-center justify-between text-sm text-muted">
      <p data-actor-count>{medien.length} Beiträge</p>
      <button
        type="button"
        class="underline decoration-line hover:decoration-accent hover:text-accent"
        data-reset-filters
      >
        Filter zurücksetzen
      </button>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-actor-grid>
      {medien.map((m) => (
        <MediaCard
          title={m.data.title}
          type={m.data.type}
          host={m.data.host}
          outlet={m.data.outlet}
          url={m.data.url}
          youtubeId={m.data.youtubeId}
          slug={m.id}
          date={m.data.date}
          durationMin={m.data.durationMin}
          paywall={m.data.paywall}
          themen={m.data.themen}
          pullquote={m.data.pullquote}
        />
      ))}
    </div>

    <p
      class="mt-10 text-center text-sm text-muted hidden"
      data-empty-state
    >
      Keine Beiträge passen zur Auswahl.
      <button type="button" class="underline text-accent" data-reset-filters>Filter zurücksetzen</button>.
    </p>
  </section>
</BaseLayout>

<script>
  let activeType: string = '__all__';

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-media-card]'),
  );
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const countEl = document.querySelector<HTMLElement>('[data-actor-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty-state]');
  const resetButtons = document.querySelectorAll<HTMLButtonElement>(
    '[data-reset-filters]',
  );

  // Map UI label → data-type value
  const labelToType: Record<string, string> = {
    Video: 'video',
    Podcast: 'podcast',
    Interview: 'interview',
    Rezension: 'rezension',
    Vortrag: 'vortrag',
  };

  function applyFilters() {
    let visible = 0;
    for (const card of cards) {
      const type = card.dataset.type ?? '';
      const show = activeType === '__all__' || type === activeType;
      card.hidden = !show;
      if (show) visible++;
    }
    if (countEl) {
      countEl.textContent =
        visible === cards.length
          ? `${cards.length} Beiträge`
          : `${visible} von ${cards.length} Beiträgen`;
    }
    if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const value = chip.dataset.filterValue ?? '__all__';
      activeType =
        value === '__all__' ? '__all__' : labelToType[value] ?? value;
      for (const c of chips) {
        const isActive = c === chip;
        c.classList.toggle('is-active', isActive);
        c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
      applyFilters();
    });
  }

  for (const btn of resetButtons) {
    btn.addEventListener('click', () => {
      activeType = '__all__';
      for (const c of chips) {
        const isAllChip = c.dataset.filterValue === '__all__';
        c.classList.toggle('is-active', isAllChip);
        c.setAttribute('aria-pressed', isAllChip ? 'true' : 'false');
      }
      applyFilters();
    });
  }
</script>
